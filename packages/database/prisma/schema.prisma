// Vistara — skema database MVP (Fase 1)
// Kategori aktif penuh: Hotel, Apartemen, Cafe/Restoran.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  PARTNER
  ADMIN
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CategoryStatus {
  ACTIVE
  COMING_SOON
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
}

enum BookingStatus {
  PENDING
  DIHUBUNGI
  SELESAI
  DIBATALKAN
}

enum InsightKategori {
  FAKTA_MENARIK
  BERITA
  TIPS
  PROMO
}

enum ArticleType {
  PROMO
  FAKTA_MENARIK
  TIPS
  BERITA
}

model Article {
  id           String      @id @default(cuid())
  judul        String
  slug         String      @unique
  tipe         ArticleType
  ringkasan    String
  gambar_url   String
  published_at DateTime
  created_at   DateTime    @default(now())

  @@index([published_at])
  @@map("articles")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(USER)
  createdAt    DateTime @default(now()) @map("created_at")

  partner  Partner?
  insights Insight[]

  @@index([role])
  @@map("users")
}

model Partner {
  id               String             @id @default(cuid())
  userId           String             @unique @map("user_id")
  namaUsaha        String             @map("nama_usaha")
  deskripsi        String?
  statusVerifikasi VerificationStatus @default(PENDING) @map("status_verifikasi")
  createdAt        DateTime           @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  listings Listing[]

  @@index([statusVerifikasi])
  @@map("partners")
}

model Category {
  id      String         @id @default(cuid())
  nama    String
  slug    String         @unique
  status  CategoryStatus @default(COMING_SOON)
  iconUrl String?        @map("icon_url")

  listings Listing[]
  insights Insight[]

  @@index([status])
  @@map("categories")
}

model Listing {
  id         String        @id @default(cuid())
  partnerId  String        @map("partner_id")
  categoryId String        @map("category_id")
  judul      String
  // slug dipakai untuk URL bersih /{kategori}/{slug} (kebutuhan SEO)
  slug       String        @unique
  deskripsi  String
  harga      Decimal       @db.Decimal(12, 2)
  lokasi     String
  latitude   Float?
  longitude  Float?
  jamBuka    String?       @map("jam_buka")
  jamTutup   String?       @map("jam_tutup")
  status     ListingStatus @default(DRAFT)
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  partner  Partner        @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  category Category       @relation(fields: [categoryId], references: [id])
  images   ListingImage[]
  bookings Booking[]

  @@index([categoryId, status])
  @@index([lokasi])
  @@index([status, createdAt])
  @@index([partnerId, status])
  @@map("listings")
}

model ListingImage {
  id        String @id @default(cuid())
  listingId String @map("listing_id")
  url       String
  urutan    Int    @default(0)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, urutan])
  @@map("listing_images")
}

model Booking {
  id               String        @id @default(cuid())
  listingId        String        @map("listing_id")
  namaPemesan      String        @map("nama_pemesan")
  noHp             String        @map("no_hp")
  tanggalKeperluan DateTime?     @map("tanggal_keperluan")
  catatan          String?
  status           BookingStatus @default(PENDING)
  createdAt        DateTime      @default(now()) @map("created_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, status])
  @@index([status, createdAt])
  @@map("bookings")
}

/// Konten informatif (fakta, berita, tips, promo) yang dikelola admin.
model Insight {
  id           String          @id @default(cuid())
  judul        String
  slug         String          @unique
  kategori     InsightKategori
  gambarUrl    String          @map("gambar_url")
  ringkasan    String
  konten       String?
  sumber       String?
  tanggalTerbit DateTime       @map("tanggal_terbit")
  aktif        Boolean         @default(true)
  dibuatOlehId String?         @map("dibuat_oleh_id")
  /// Kategori layanan yang dibahas. Null berarti konten umum, tidak terikat kategori.
  kategoriTerkaitId String?    @map("kategori_terkait_id")
  /// Penanda data contoh supaya mudah dipisahkan dari konten asli nanti.
  isDummy      Boolean         @default(false) @map("is_dummy")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  dibuatOleh      User?     @relation(fields: [dibuatOlehId], references: [id], onDelete: SetNull)
  kategoriTerkait Category? @relation(fields: [kategoriTerkaitId], references: [id], onDelete: SetNull)

  @@index([aktif, tanggalTerbit])
  @@index([kategori, aktif])
  @@index([kategoriTerkaitId, aktif])
  @@map("insights")
}
